# Шаблон. Реальный файл: secrets/openclaw.enc.yaml
#
# Создание:
#   cp secrets/openclaw.enc.yaml.example secrets/openclaw.enc.yaml
#   # вписать настоящие значения
#   sops --encrypt --in-place secrets/openclaw.enc.yaml
#
# Редактирование потом (расшифровка только в памяти редактора):
#   sops secrets/openclaw.enc.yaml
#
# Проверь перед коммитом, что значения выглядят как ENC[AES256_GCM,...]

# --- Образ ---------------------------------------------------------
# Пин по digest. Тег latest использовать нельзя: он мутабельный,
# и два реконсиля на одном коммите дадут разный результат.
# Digest узнать: docker buildx imagetools inspect ghcr.io/openclaw/openclaw:latest
OPENCLAW_IMAGE: ghcr.io/openclaw/openclaw@sha256:REPLACE_WITH_REAL_DIGEST

# --- Пути ----------------------------------------------------------
OPENCLAW_STATE_DIR: /opt/openclaw-state

# --- Gateway -------------------------------------------------------
# Генерируется при первичном онбординге, потом кладётся сюда.
OPENCLAW_GATEWAY_TOKEN: replace-me

# --- LLM через BotHub (OpenAI-совместимый) -------------------------
OPENAI_API_KEY: replace-me
OPENAI_BASE_URL: https://bothub.chat/api/v2/openai/v1

# --- Запасной провайдер: Cloud.ru Foundation Models ----------------
# Личный ключ на время MVP. При выделении бюджета заменить на
# корпоративный — отметить в ROADMAP, чтобы не забылось.
CLOUDRU_API_KEY: replace-me

# --- Telegram ------------------------------------------------------
# Основной бот
TELEGRAM_BOT_TOKEN: replace-me

# --- Алерты деплоя -------------------------------------------------
# ОТДЕЛЬНЫЙ бот, намеренно вне стека OpenClaw. Если реконсиль уронил
# гейтвей, алертить через него же невозможно — это ровно тот случай,
# ради которого алерт и нужен.
ALERT_BOT_TOKEN: replace-me
ALERT_CHAT_ID: replace-me