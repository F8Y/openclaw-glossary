[Unit]
Description=OpenClaw GitOps reconcile
Documentation=https://github.com/F8Y/openclaw-glossary
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Молчаливый таймер — худший вид автоматизации.
OnFailure=openclaw-reconcile-failure.service

[Service]
Type=oneshot
User=root

# Создаёт /run/openclaw с нужными правами. /run — tmpfs, поэтому
# расшифрованные секреты не попадают на диск и не переживают ребут.
RuntimeDirectory=openclaw
RuntimeDirectoryMode=0700

# Без этого systemd удаляет /run/openclaw при остановке юнита, а
# Type=oneshot завершается сразу после реконсиля. Тогда расшифрованный
# .env исчезает и ручные команды docker compose падают с
# "couldn't find env file". Секреты всё равно в tmpfs: ребут их стирает.
RuntimeDirectoryPreserve=yes

StateDirectory=openclaw-deploy
StateDirectoryMode=0750

Environment=REPO_DIR=/opt/openclaw-glossary
Environment=BRANCH=deploy
Environment=RUN_DIR=/run/openclaw
Environment=STATE_DIR=/var/lib/openclaw-deploy

ExecStart=/opt/openclaw-glossary/deploy/reconcile.sh

# Больше цикла таймера: если прогон завис, лучше убить его,
# чем копить параллельные попытки.
TimeoutStartSec=600

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target