{
  "id": "tavily",
  "name": "Tavily Search Provider",
  "description": "Pinned Tavily web_search provider for Glossaryck",
  "version": "2026.7.1-4",
  "activation": {
    "onStartup": true
  },
  "setup": {
    "providers": [
      {
        "id": "tavily",
        "envVars": [
          "TAVILY_API_KEY"
        ]
      }
    ]
  },
  "contracts": {
    "webSearchProviders": [
      "tavily"
    ]
  },
  "uiHints": {
    "webSearch.apiKey": {
      "label": "Tavily API Key",
      "sensitive": true,
      "placeholder": "tvly-..."
    },
    "webSearch.baseUrl": {
      "label": "Tavily Base URL"
    },
    "webSearch.proxyUrl": {
      "label": "Tavily Proxy URL",
      "sensitive": true,
      "placeholder": "http://proxy.example:8080"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": [
              "string",
              "object"
            ]
          },
          "baseUrl": {
            "type": "string"
          },
          "proxyUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
